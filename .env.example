# ── 비워 두면 '데모 모드' (메모리 DB, 데모 데이터 자동 생성, 운영 DB 와 완전히 분리) ──

# Supabase Postgres 연결 문자열 (Supabase → Project Settings → Database → Connection string)
# Vercel 에서는 Transaction pooler(포트 6543) 주소를 쓰세요.
DATABASE_URL=

# 세션 쿠키 서명 + QR 토큰 생성용 비밀값 (32자 이상 무작위). 바꾸면 모든 QR 이 새로 발급된 것처럼 바뀝니다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 관리자(/admin) 및 현장 키오스크(/check-in) 로그인 비밀번호. 데모 모드 기본값은 admin1234
ADMIN_PASSWORD=

# Supabase Realtime (휴대폰 달력 실시간 반영). 셋 중 하나라도 비면 3초 폴링으로 대신합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase → Project Settings → JWT Keys → Legacy JWT Secret
SUPABASE_JWT_SECRET=
